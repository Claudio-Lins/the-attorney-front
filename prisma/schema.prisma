// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums

enum Role {
  ADMIN
  USER

  @@map("role")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("priority")
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("service_status")
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED

  @@map("marital_status")
}


// Auth Models (Next-Auth)

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  password      String?
  role          Role            @default(USER)
  image         String?
  accounts      Account[]
  sessions      Session[]
  Authenticator Authenticator[]
  client        client?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}


// App-specific Models

model client {
  id                  String           @id @default(uuid())
  client_id           String           @unique
  first_name          String
  last_name           String
  email               String?          @unique
  marital_status      MaritalStatus    @default(SINGLE)
  passport_number     String           @unique
  passport_expiry     DateTime?        @db.Timestamp(6)
  nationality         String?
  place_of_birth      String?
  date_of_birth       DateTime?        @db.Timestamp(6)
  gender              String?
  filiation           Json?
  created_at          DateTime         @default(now()) @db.Timestamp(6)
  updated_at          DateTime         @updatedAt @db.Timestamp(6)
  phone               String?
  photo_url           String?
  country_of_birth    String?
  passport_issue_date DateTime?        @db.Timestamp(6)
  
  address             address[]
  client_service      client_service[]

  // Relation to User model for authentication
  userId              String?          @unique
  user                User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model address {
  id           String   @id @default(uuid())
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zip_code     String
  country      String
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)
  client_id    String
  client       client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model client_service {
  id                     String                   @id @default(uuid())
  client_id              String
  service_id             String
  status                 ServiceStatus            @default(PENDING)
  start_date             DateTime?                @db.Timestamp(6)
  end_date               DateTime?                @db.Timestamp(6)
  notes                  String?
  documents              Json?
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @updatedAt @db.Timestamp(6)
  assigned_to            String?
  priority               Priority                 @default(MEDIUM)
  os_number              String?
  
  client                 client                   @relation(fields: [client_id], references: [id])
  service                service                  @relation(fields: [service_id], references: [id])
  client_service_history client_service_history[]

  @@unique([client_id, service_id])
}

model client_service_history {
  id                String         @id @default(uuid())
  client_service_id String
  changed_at        DateTime       @default(now()) @db.Timestamp(6)
  changed_by        String?
  field             String
  old_value         String?
  new_value         String?
  note              String?
  client_service    client_service @relation(fields: [client_service_id], references: [id], onDelete: Cascade)
}

model service {
  id               String           @id @default(uuid())
  name             String
  description      String
  price            Float
  duration         Int?
  is_active        Boolean          @default(true)
  created_at       DateTime         @default(now()) @db.Timestamp(6)
  updated_at       DateTime         @updatedAt @db.Timestamp(6)
  category_id      String
  
  client_service   client_service[]
  service_category service_category @relation(fields: [category_id], references: [id])
}

model service_category {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @db.Timestamp(6)
  
  service     service[]
}